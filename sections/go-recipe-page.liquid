<article class="go-recipe">
  <div class="go-section go-section--cream"><div class="go-shell go-recipe__hero">{% if article.image %}<div class="go-media">{{ article.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '700,1100,1500,1800' }}</div>{% endif %}<div><div class="go-kicker">GO GROCER RECIPE</div><h1 class="go-display">{{ article.title }}</h1><div class="go-recipe__meta">{% if article.metafields.custom.recipe_protein != blank %}<span>{{ article.metafields.custom.recipe_protein.value }}</span>{% endif %}{% if article.metafields.custom.recipe_time != blank %}<span>{{ article.metafields.custom.recipe_time.value }}</span>{% endif %}{% if article.metafields.custom.recipe_difficulty != blank %}<span>{{ article.metafields.custom.recipe_difficulty.value }}</span>{% endif %}{% if article.metafields.custom.recipe_servings != blank %}<span>{{ article.metafields.custom.recipe_servings.value }}</span>{% endif %}</div><p>{{ article.excerpt_or_content | strip_html | truncatewords: 44 }}</p></div></div></div>

  {% if article.metafields.custom.recipe_ingredients != blank %}<div class="go-section"><div class="go-reading"><div class="go-kicker">INGREDIENTS</div><h2 class="go-h2">WHAT YOU’LL NEED</h2><div class="go-rte go-recipe__rich">{{ article.metafields.custom.recipe_ingredients | metafield_tag }}</div></div></div>{% endif %}

  {% assign related = article.metafields.custom.recipe_related_products.value %}{% if related != blank %}<div class="go-section go-section--oat"><div class="go-shell"><div class="go-kicker">SHOP THIS RECIPE</div><div class="go-recipe__products">{% for product in related %}<a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,500,800' }}{% endif %}<strong>{{ product.title }}</strong><span>{{ product.price | money }}</span></a>{% endfor %}</div></div></div>{% endif %}

  <div class="go-section"><div class="go-reading"><div class="go-kicker">METHOD</div><h2 class="go-h2">MAKE IT</h2>{% if article.metafields.custom.recipe_steps != blank %}<div class="go-rte go-recipe__rich">{{ article.metafields.custom.recipe_steps | metafield_tag }}</div>{% else %}<div class="go-rte go-recipe__rich">{{ article.content }}</div>{% endif %}</div></div>

  {% if article.metafields.custom.recipe_nutrition != blank %}<div class="go-section go-section--sage"><div class="go-reading"><div class="go-kicker">NUTRITION</div><div class="go-rte">{{ article.metafields.custom.recipe_nutrition | metafield_tag }}</div><p class="go-recipe__disclaimer">Nutrition values are estimates and may vary depending on the specific ingredients, products, and serving sizes used.</p></div></div>{% endif %}

  {% if article.metafields.custom.recipe_swaps != blank %}<div class="go-section"><div class="go-reading"><div class="go-kicker">SWAPS &amp; NOTES</div><div class="go-rte">{{ article.metafields.custom.recipe_swaps | metafield_tag }}</div></div></div>{% endif %}

  {% if section.settings.protein_day_url != blank %}<div class="go-section go-section--dark"><div class="go-shell go-recipe__cta"><div><div class="go-kicker">PROTEIN MADE EASY.</div><h2 class="go-h2">BUILD YOUR PROTEIN DAY.</h2></div><a class="go-btn" href="{{ section.settings.protein_day_url }}">BUILD YOUR DAY →</a></div></div>{% endif %}
</article>
<style>
#shopify-section-{{ section.id }} .go-recipe__hero{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center;}#shopify-section-{{ section.id }} .go-recipe__hero .go-media{aspect-ratio:4/3;}#shopify-section-{{ section.id }} .go-recipe__meta{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0;}#shopify-section-{{ section.id }} .go-recipe__meta span{padding:7px 10px;background:#fff;border:1px solid var(--go-line);font-size:10px;font-weight:700;}#shopify-section-{{ section.id }} .go-recipe__rich{margin-top:24px;font-size:17px;line-height:1.7;}#shopify-section-{{ section.id }} .go-recipe__products{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:24px;}#shopify-section-{{ section.id }} .go-recipe__products a{color:inherit;text-decoration:none;}#shopify-section-{{ section.id }} .go-recipe__products img{width:100%;aspect-ratio:4/5;object-fit:cover;display:block;margin-bottom:10px;}#shopify-section-{{ section.id }} .go-recipe__products strong,#shopify-section-{{ section.id }} .go-recipe__products span{display:block;}#shopify-section-{{ section.id }} .go-recipe__disclaimer{font-size:11px;opacity:.65;margin-top:20px;}#shopify-section-{{ section.id }} .go-recipe__cta{display:flex;justify-content:space-between;align-items:center;gap:30px;}
@media(max-width:749px){#shopify-section-{{ section.id }} .go-recipe__hero{grid-template-columns:1fr;}#shopify-section-{{ section.id }} .go-recipe__products{grid-template-columns:repeat(2,1fr);}#shopify-section-{{ section.id }} .go-recipe__cta{align-items:flex-start;flex-direction:column;}}
</style>
{% schema %}{"name":"GO Recipe article","settings":[{"type":"url","id":"protein_day_url","label":"Build Your Protein Day link"}],"presets":[{"name":"GO Recipe article"}]}{% endschema %}
