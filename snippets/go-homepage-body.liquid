<div class="go-home">
{% for block in section.blocks %}
{% case block.type %}
{% when 'hero' %}
<section class="gh-hero" {{ block.shopify_attributes }} style="--bg:{{ block.settings.bg }};--tx:{{ block.settings.text_color }};--h:{{ block.settings.height }}px;--hm:{{ block.settings.height_m }}px;--wash:{{ block.settings.wash | divided_by: 100.0 }}">
{% if block.settings.image != blank %}<div class="gh-hero__media">{{ block.settings.image | image_url: width: 2600 | image_tag: loading:'eager', fetchpriority:'high', widths:'900,1400,1900,2600', sizes:'100vw' }}</div>{% endif %}<div class="gh-hero__wash"></div><div class="gh-wrap gh-hero__inner"><div class="gh-copy">{% if block.settings.eyebrow != blank %}<p class="gh-kicker">{{ block.settings.eyebrow }}</p>{% endif %}<h1>{{ block.settings.heading }}</h1>{% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}<div class="gh-actions">{% if block.settings.button_label != blank %}<a class="gh-btn" {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% endif %}>{{ block.settings.button_label }}</a>{% endif %}{% if block.settings.button2_label != blank %}<a class="gh-btn gh-btn--ghost" {% if block.settings.button2_link != blank %}href="{{ block.settings.button2_link }}"{% endif %}>{{ block.settings.button2_label }}</a>{% endif %}</div></div></div></section>
{% when 'categories' %}
<section class="gh-sec" {{ block.shopify_attributes }} style="--bg:{{ block.settings.bg }};--tx:{{ block.settings.text_color }}"><div class="gh-wrap"><header class="gh-head"><p class="gh-kicker">{{ block.settings.eyebrow }}</p><h2>{{ block.settings.heading }}</h2>{{ block.settings.text }}</header><div class="gh-cats">{% for i in (1..6) %}{% assign k='cat'|append:i|append:'_collection' %}{% assign ik='cat'|append:i|append:'_image' %}{% assign tk='cat'|append:i|append:'_title' %}{% assign c=block.settings[k] %}{% assign im=block.settings[ik] %}{% assign t=block.settings[tk] %}{% if im==blank and c!=blank %}{% assign im=c.featured_image %}{% endif %}<article>{% if c!=blank %}<a href="{{ c.url }}">{% endif %}<div class="gh-square">{% if im!=blank %}{{ im | image_url: width:900 | image_tag: loading:'lazy', widths:'360,600,900' }}{% endif %}</div><h3>{% if t!=blank %}{{ t }}{% elsif c!=blank %}{{ c.title }}{% endif %}</h3>{% if c!=blank %}</a>{% endif %}</article>{% endfor %}</div></div></section>
{% when 'editorial' %}
<section class="gh-edit{% if block.settings.reverse %} reverse{% endif %}" {{ block.shopify_attributes }} style="--bg:{{ block.settings.bg }};--tx:{{ block.settings.text_color }}"><div class="gh-edit__media">{% if block.settings.image!=blank %}{{ block.settings.image | image_url: width:1800 | image_tag: loading:'lazy', widths:'700,1100,1500,1800' }}{% endif %}</div><div class="gh-edit__copy"><div><p class="gh-kicker">{{ block.settings.eyebrow }}</p><h2>{{ block.settings.heading }}</h2>{{ block.settings.text }}{% if block.settings.button_label!=blank %}<a class="gh-link" {% if block.settings.button_link!=blank %}href="{{ block.settings.button_link }}"{% endif %}>{{ block.settings.button_label }}</a>{% endif %}</div></div></section>
{% when 'protein_day' %}
<section class="gh-sec" {{ block.shopify_attributes }} style="--bg:{{ block.settings.bg }};--tx:{{ block.settings.text_color }}"><div class="gh-wrap"><header class="gh-head"><p class="gh-kicker">{{ block.settings.eyebrow }}</p><h2>{{ block.settings.heading }}</h2>{{ block.settings.text }}</header><div class="gh-meals">{% for i in (1..4) %}{% assign ik='meal'|append:i|append:'_image' %}{% assign tk='meal'|append:i|append:'_title' %}{% assign pk='meal'|append:i|append:'_protein' %}<article><div class="gh-square">{% if block.settings[ik]!=blank %}{{ block.settings[ik] | image_url: width:900 | image_tag: loading:'lazy', widths:'400,650,900' }}{% endif %}<span>{{ block.settings[pk] }}</span></div><h3>{{ block.settings[tk] }}</h3></article>{% endfor %}</div><div class="gh-summary">{{ block.settings.summary }}</div>{% if block.settings.button_label!=blank %}<a class="gh-btn" {% if block.settings.button_link!=blank %}href="{{ block.settings.button_link }}"{% endif %}>{{ block.settings.button_label }}</a>{% endif %}</div></section>
{% when 'featured' %}
<section class="gh-sec" {{ block.shopify_attributes }} style="--bg:{{ block.settings.bg }};--tx:{{ block.settings.text_color }}"><div class="gh-wrap"><header class="gh-head gh-row"><div><p class="gh-kicker">{{ block.settings.eyebrow }}</p><h2>{{ block.settings.heading }}</h2>{{ block.settings.text }}</div>{% if block.settings.collection!=blank %}<a class="gh-link" href="{{ block.settings.collection.url }}">{{ block.settings.view_label }}</a>{% endif %}</header>{% assign col=block.settings.collection %}{% if col!=blank %}<div class="gh-products">{% for product in col.products limit:block.settings.limit %}<article><a href="{{ product.url }}" class="gh-prodimg">{% if product.featured_image %}{{ product.featured_image | image_url: width:900 | image_tag: loading:'lazy', widths:'360,600,900' }}{% endif %}{% if product.metafields.custom.protein_per_serving!=blank %}<span>{{ product.metafields.custom.protein_per_serving.value }}</span>{% endif %}</a>{% if product.vendor!=blank %}<small>{{ product.vendor }}</small>{% endif %}<h3><a href="{{ product.url }}">{{ product.title }}</a></h3><strong>{{ product.price | money }}</strong></article>{% endfor %}</div>{% else %}<p>Select a collection in Theme Editor.</p>{% endif %}</div></section>
{% when 'cards' %}
<section class="gh-sec" {{ block.shopify_attributes }} style="--bg:{{ block.settings.bg }};--tx:{{ block.settings.text_color }}"><div class="gh-wrap"><header class="gh-head"><p class="gh-kicker">{{ block.settings.eyebrow }}</p><h2>{{ block.settings.heading }}</h2>{{ block.settings.text }}</header><div class="gh-cards">{% for i in (1..3) %}{% assign ik='card'|append:i|append:'_image' %}{% assign tk='card'|append:i|append:'_title' %}{% assign xk='card'|append:i|append:'_text' %}{% assign lk='card'|append:i|append:'_link' %}<a {% if block.settings[lk]!=blank %}href="{{ block.settings[lk] }}"{% endif %}><div class="gh-wide">{% if block.settings[ik]!=blank %}{{ block.settings[ik] | image_url: width:1200 | image_tag: loading:'lazy', widths:'500,800,1200' }}{% endif %}</div><h3>{{ block.settings[tk] }}</h3><p>{{ block.settings[xk] }}</p></a>{% endfor %}</div></div></section>
{% when 'promo' %}
<section class="gh-promo" {{ block.shopify_attributes }} style="--bg:{{ block.settings.bg }};--tx:{{ block.settings.text_color }}"><div class="gh-promo__media">{% if block.settings.image!=blank %}{{ block.settings.image | image_url: width:2000 | image_tag: loading:'lazy', widths:'800,1200,1600,2000' }}{% endif %}</div><div class="gh-promo__copy"><p class="gh-kicker">{{ block.settings.eyebrow }}</p><h2>{{ block.settings.heading }}</h2>{{ block.settings.text }}{% if block.settings.button_label!=blank %}<a class="gh-btn" {% if block.settings.button_link!=blank %}href="{{ block.settings.button_link }}"{% endif %}>{{ block.settings.button_label }}</a>{% endif %}</div></section>
{% when 'blog' %}
<section class="gh-sec" {{ block.shopify_attributes }} style="--bg:{{ block.settings.bg }};--tx:{{ block.settings.text_color }}"><div class="gh-wrap"><header class="gh-head"><p class="gh-kicker">{{ block.settings.eyebrow }}</p><h2>{{ block.settings.heading }}</h2>{{ block.settings.text }}</header>{% assign b=block.settings.blog %}{% if b!=blank %}<div class="gh-blog">{% for article in b.articles limit:block.settings.limit %}<article><a href="{{ article.url }}"><div class="gh-wide">{% if article.image %}{{ article.image | image_url: width:1100 | image_tag: loading:'lazy', widths:'500,800,1100' }}{% endif %}</div><h3>{{ article.title }}</h3></a></article>{% endfor %}</div>{% else %}<p>Select a recipe blog in Theme Editor.</p>{% endif %}</div></section>
{% when 'newsletter' %}
<section class="gh-sec gh-news" {{ block.shopify_attributes }} style="--bg:{{ block.settings.bg }};--tx:{{ block.settings.text_color }}"><div class="gh-wrap gh-row"><div><p class="gh-kicker">{{ block.settings.eyebrow }}</p><h2>{{ block.settings.heading }}</h2>{{ block.settings.text }}</div>{% form 'customer', class:'gh-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="Email address" required><button type="submit">{{ block.settings.button_label }}</button>{% endform %}</div></section>
{% endcase %}
{% endfor %}
</div>
