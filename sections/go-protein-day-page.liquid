<section class="go-protein-builder">
  <div class="go-section go-section--cream"><div class="go-shell go-protein-builder__hero"><div><div class="go-kicker">PROTEIN MADE EASY.</div><h1 class="go-display">BUILD YOUR PROTEIN DAY.</h1><div class="go-copy"><p>Simple groceries. Familiar meals. A straightforward way to make protein part of your day.</p></div></div>{% if section.settings.hero_image != blank %}<div class="go-media">{{ section.settings.hero_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600,900,1200,1600' }}</div>{% endif %}</div></div>
  <div class="go-section"><div class="go-shell"><div class="go-kicker">HOW IT WORKS</div><div class="go-protein-builder__steps"><div><span>01</span><strong>Pick a meal.</strong><p>Start with the part of the day you want to make easier.</p></div><div><span>02</span><strong>Choose your protein.</strong><p>Build around a protein-forward grocery or ready option.</p></div><div><span>03</span><strong>Stock your fridge.</strong><p>Shop the pieces you will actually use through the week.</p></div></div></div></div>
  <div class="go-section go-section--oat"><div class="go-shell"><div class="go-kicker">ONE DAY. 120G PROTEIN.</div><div class="go-protein-builder__meals">{% for block in section.blocks %}{% if block.type == 'meal' %}<article class="go-protein-builder__meal" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<div class="go-media">{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,700,1000' }}</div>{% endif %}<div class="go-protein-builder__meal-copy"><span>{{ block.settings.protein }}</span><h2>{{ block.settings.title }}</h2><p>{{ block.settings.text }}</p>{% if block.settings.collection != blank %}<a href="{{ block.settings.collection.url }}">SHOP {{ block.settings.title | upcase }} →</a>{% endif %}</div></article>{% endif %}{% endfor %}</div></div></div>
  <div class="go-section go-section--dark"><div class="go-shell go-protein-builder__summary"><div><div class="go-kicker">THE SIMPLE VERSION</div><h2>ONE DAY.<br>120G PROTEIN.</h2></div><div class="go-copy go-rte">{{ section.settings.summary_text }}</div></div></div>
  <div class="go-section"><div class="go-shell"><div class="go-kicker">SHOP THE DAY</div><h2 class="go-h2">START WHERE YOU NEED IT.</h2><div class="go-protein-builder__shop">{% for block in section.blocks %}{% if block.type == 'shop' and block.settings.collection != blank %}<a href="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title }} →</a>{% endif %}{% endfor %}</div></div></div>
  <div class="go-section go-section--sage"><div class="go-shell"><div class="go-kicker">MAKE IT YOUR OWN</div><div class="go-protein-builder__flex">{% for block in section.blocks %}{% if block.type == 'tip' %}<div {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endif %}{% endfor %}</div></div></div>
  <div class="go-section"><div class="go-reading"><div class="go-kicker">QUICK QUESTIONS</div><div class="go-accordion">{% for block in section.blocks %}{% if block.type == 'faq' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }} <span>+</span></summary><div>{{ block.settings.answer }}</div></details>{% endif %}{% endfor %}</div></div></div>
</section>
<style>
#shopify-section-{{ section.id }} .go-protein-builder__hero{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;}#shopify-section-{{ section.id }} .go-protein-builder__hero .go-media{aspect-ratio:4/3;}#shopify-section-{{ section.id }} .go-protein-builder__steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:28px;}#shopify-section-{{ section.id }} .go-protein-builder__steps>div{border-top:1px solid var(--go-line);padding-top:16px;}#shopify-section-{{ section.id }} .go-protein-builder__steps span{font-size:11px;opacity:.5;}#shopify-section-{{ section.id }} .go-protein-builder__steps strong{display:block;font-size:24px;margin:34px 0 6px;}#shopify-section-{{ section.id }} .go-protein-builder__meals{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:24px;}#shopify-section-{{ section.id }} .go-protein-builder__meal{background:#fff;}#shopify-section-{{ section.id }} .go-protein-builder__meal .go-media{aspect-ratio:4/3;}#shopify-section-{{ section.id }} .go-protein-builder__meal-copy{padding:20px;}#shopify-section-{{ section.id }} .go-protein-builder__meal-copy span{font-size:11px;font-weight:700;color:var(--go-green);}#shopify-section-{{ section.id }} .go-protein-builder__meal-copy h2{font-size:28px;margin:8px 0;}#shopify-section-{{ section.id }} .go-protein-builder__meal-copy a{font-size:11px;font-weight:700;color:inherit;}#shopify-section-{{ section.id }} .go-protein-builder__summary{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:end;}#shopify-section-{{ section.id }} .go-protein-builder__summary h2{font-size:clamp(58px,9vw,130px);line-height:.82;letter-spacing:-.065em;margin:8px 0 0;}#shopify-section-{{ section.id }} .go-protein-builder__shop{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px;}#shopify-section-{{ section.id }} .go-protein-builder__shop a{padding:12px 16px;border:1px solid var(--go-line);border-radius:999px;color:inherit;text-decoration:none;font-size:12px;font-weight:700;}#shopify-section-{{ section.id }} .go-protein-builder__flex{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:24px;}#shopify-section-{{ section.id }} .go-protein-builder__flex>div{padding:24px;border:1px solid rgba(23,23,23,.2);}
@media(max-width:749px){#shopify-section-{{ section.id }} .go-protein-builder__hero,#shopify-section-{{ section.id }} .go-protein-builder__summary{grid-template-columns:1fr;}#shopify-section-{{ section.id }} .go-protein-builder__steps,#shopify-section-{{ section.id }} .go-protein-builder__meals,#shopify-section-{{ section.id }} .go-protein-builder__flex{grid-template-columns:1fr;}}
</style>
{% schema %}
{
  "name":"GO Protein day page",
  "settings":[
    {"type":"image_picker","id":"hero_image","label":"Hero image"},
    {"type":"richtext","id":"summary_text","label":"120g summary","default":"<p>For example: 30g at breakfast, 35g at lunch, 20g from a snack and 35g at dinner. Your day does not need to look exactly like this. Use it as a simple grocery framework, not a nutrition prescription.</p>"}
  ],
  "blocks":[
    {"type":"meal","name":"Meal","settings":[{"type":"text","id":"title","label":"Meal"},{"type":"text","id":"protein","label":"Protein example"},{"type":"textarea","id":"text","label":"Text"},{"type":"image_picker","id":"image","label":"Image"},{"type":"collection","id":"collection","label":"Shop collection"}]},
    {"type":"shop","name":"Shop tab","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"label","label":"Label"}]},
    {"type":"tip","name":"Make it your own","settings":[{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"text","label":"Text"}]},
    {"type":"faq","name":"FAQ","settings":[{"type":"text","id":"question","label":"Question"},{"type":"richtext","id":"answer","label":"Answer"}]}
  ],
  "presets":[{"name":"GO Protein day page","blocks":[
    {"type":"meal","settings":{"title":"BREAKFAST","protein":"30G PROTEIN","text":"Start with an easy breakfast you can actually repeat."}},
    {"type":"meal","settings":{"title":"LUNCH","protein":"35G PROTEIN","text":"Build lunch around a familiar protein and simple sides."}},
    {"type":"meal","settings":{"title":"SNACK","protein":"20G PROTEIN","text":"Keep an easy protein option ready for the space between meals."}},
    {"type":"meal","settings":{"title":"DINNER","protein":"35G PROTEIN","text":"Finish with a straightforward protein-forward dinner."}},
    {"type":"tip","settings":{"title":"SWAP THE PROTEIN","text":"Chicken today, salmon tomorrow, yogurt when you need something fast."}},
    {"type":"tip","settings":{"title":"USE WHAT YOU LIKE","text":"The easiest routine is the one built around food you already enjoy."}},
    {"type":"tip","settings":{"title":"KEEP A BACKUP","text":"Ready meals and simple snacks help when the plan changes."}},
    {"type":"faq","settings":{"question":"Is this a macro calculator?","answer":"<p>No. This page is a simple grocery and meal-building framework, not a personalized macro or medical nutrition calculator.</p>"}},
    {"type":"faq","settings":{"question":"Do I need to hit exactly 120g?","answer":"<p>No. The numbers are editable examples to show how protein can be spread across a day. Individual needs vary.</p>"}}
  ]}]
}
{% endschema %}
