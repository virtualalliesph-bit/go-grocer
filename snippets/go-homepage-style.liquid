<style>
.go-home{--black:#171717;--green:#526653}.gh-wrap{width:min(100% - 40px,1440px);margin:auto}.gh-sec{background:var(--bg);color:var(--tx);padding:72px 0}.gh-kicker{margin:0 0 10px;font-size:11px;font-weight:800;letter-spacing:.15em;text-transform:uppercase}.gh-head{max-width:760px;margin-bottom:30px}.gh-head h2,.gh-edit h2,.gh-promo h2,.gh-news h2{margin:0;font-size:clamp(34px,4vw,56px);line-height:.96;letter-spacing:-.045em}.gh-head .rte,.gh-edit .rte,.gh-promo .rte{margin-top:16px}.gh-btn{display:inline-flex;min-height:46px;align-items:center;padding:10px 18px;background:var(--green);color:#fff;text-decoration:none;border-radius:4px;font-size:12px;font-weight:800}.gh-btn--ghost{background:rgba(247,245,240,.7);color:var(--black);border:1px solid currentColor}.gh-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px}.gh-link{display:inline-block;margin-top:22px;color:inherit;font-size:12px;font-weight:800;text-decoration:none}.gh-hero{position:relative;background:var(--bg);color:var(--tx);min-height:var(--h);overflow:hidden}.gh-hero__media{position:absolute;inset:0}.gh-hero__media img{width:100%;height:100%;object-fit:cover}.gh-hero__wash{position:absolute;inset:0;background:linear-gradient(90deg,rgba(247,245,240,var(--wash)) 0%,rgba(247,245,240,.72) 43%,rgba(247,245,240,0) 72%)}.gh-hero__inner{position:relative;min-height:var(--h);display:flex;align-items:center}.gh-copy{max-width:620px}.gh-copy h1{margin:0;font-size:clamp(46px,5.5vw,78px);line-height:.92;letter-spacing:-.055em}.gh-cats{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}.gh-cats a,.gh-products a,.gh-cards a,.gh-blog a{color:inherit;text-decoration:none}.gh-square,.gh-prodimg{position:relative;aspect-ratio:1;background:#fff;overflow:hidden}.gh-square img,.gh-prodimg img,.gh-wide img,.gh-edit__media img,.gh-promo__media img{width:100%;height:100%;object-fit:cover}.gh-cats h3,.gh-meals h3,.gh-products h3,.gh-cards h3,.gh-blog h3{margin:10px 0 0;font-size:16px}.gh-edit,.gh-promo{display:gr