{% liquid
  assign eyebrow = collection.metafields.custom.eyebrow.value | default: section.settings.eyebrow
  assign short_desc = collection.metafields.custom.short_description.value | default: collection.description
  assign hero_image = collection.metafields.custom.hero_image.value | default: collection.image
%}
<section class="go-collection" style="--go-accent:{{ section.settings.accent }};--go-hero-bg:{{ section.settings.hero_bg }};">
  <div class="go-collection__hero">
    <div class="go-shell go-collection__hero-grid">
      <div class="go-collection__hero-copy">
        {% if eyebrow != blank %}<div class="go-kicker">{{ eyebrow }}</div>{% endif %}
        <h1 class="go-display">{{ collection.title }}</h1>
        {% if short_desc != blank %}<div class="go-copy go-rte">{{ short_desc }}</div>{% endif %}
      </div>
      {% if hero_image != blank %}<div class="go-collection__hero-media">{{ hero_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '640,960,1200,1600', sizes: '(min-width: 750px) 45vw, 100vw', alt: collection.title }}</div>{% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="go-shell go-collection__subnav">
      {% for block in section.blocks %}{% if block.settings.collection != blank %}<a href="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title }}</a>{% endif %}{% endfor %}
    </div>
  {% endif %}

  <div class="go-shell go-collection__toolbar">
    <div>{{ collection.products_count }} products</div>
    <form method="get"><label for="SortBy-{{ section.id }}">Sort</label><select id="SortBy-{{ section.id }}" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form>
  </div>

  {% paginate collection.products by section.settings.products_per_page %}
  <div class="go-shell go-collection__body">
    {% if section.settings.show_filters and collection.filters.size > 0 %}
      <aside class="go-collection__filters">
        <form method="get" id="GoFilters-{{ section.id }}">
          {% if collection.sort_by != blank %}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{% endif %}
          {% for filter in collection.filters %}
            <details open>
              <summary>{{ filter.label }}</summary>
              <div class="go-filter-values">
                {% case filter.type %}
                  {% when 'list', 'boolean' %}
                    {% for value in filter.values %}
                      <label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}> <span>{{ value.label }} ({{ value.count }})</span></label>
                    {% endfor %}
                  {% when 'price_range' %}
                    <label>Min <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" min="0"></label>
                    <label>Max <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" min="0"></label>
                {% endcase %}
              </div>
            </details>
          {% endfor %}
          <button class="go-btn" type="submit">APPLY FILTERS</button>
          <a href="{{ collection.url }}">Clear</a>
        </form>
      </aside>
    {% endif %}

    <div class="go-collection__main">
      {% if collection.products.size > 0 %}
        <div class="go-product-grid">
          {% for product in collection.products %}
            <article class="go-product-card">
              <a class="go-product-card__media" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 990px) 22vw, 50vw', alt: product.title }}{% endif %}{% if product.metafields.custom.protein_per_serving != blank %}<span class="go-badge">{{ product.metafields.custom.protein_per_serving.value }}</span>{% endif %}</a>
              <div class="go-product-card__info">
                {% if section.settings.show_vendor and product.vendor != blank %}<div class="go-kicker">{{ product.vendor }}</div>{% endif %}
                <a class="go-product-card__title" href="{{ product.url }}">{{ product.title }}</a>
                {% if product.metafields.custom.short_description != blank %}<div class="go-product-card__desc">{{ product.metafields.custom.short_description.value }}</div>{% endif %}
                <div class="go-product-card__row"><span class="go-price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</span></div>
                {% if product.available %}
                  {% if product.has_only_default_variant %}
                    {% form 'product', product %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="go-product-card__action" type="submit">QUICK ADD</button>{% endform %}
                  {% else %}
                    <a class="go-product-card__action" href="{{ product.url }}">CHOOSE OPTIONS</a>
                  {% endif %}
                {% else %}<span class="go-product-card__action is-disabled">SOLD OUT</span>{% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      {% else %}<div class="go-empty">No products found.</div>{% endif %}
      {% if paginate.pages > 1 %}<nav class="go-pagination">{{ paginate | default_pagination }}</nav>{% endif %}
    </div>
  </div>
  {% endpaginate %}

  {% if section.settings.bottom_copy != blank %}<div class="go-reading go-collection__bottom go-rte">{{ section.settings.bottom_copy }}</div>{% endif %}
</section>
<style>
#shopify-section-{{ section.id }} .go-collection__hero{background:var(--go-hero-bg);padding:46px 0;}#shopify-section-{{ section.id }} .go-collection__hero-grid{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:42px;}#shopify-section-{{ section.id }} .go-collection__hero-copy{max-width:720px;}#shopify-section-{{ section.id }} .go-collection__hero-copy .go-copy{max-width:58ch;margin-top:18px;}#shopify-section-{{ section.id }} .go-collection__hero-media{aspect-ratio:16/10;overflow:hidden;}#shopify-section-{{ section.id }} .go-collection__hero-media img{width:100%;height:100%;object-fit:cover;}
#shopify-section-{{ section.id }} .go-collection__subnav{display:flex;gap:10px;overflow:auto;padding-top:20px;padding-bottom:8px;}#shopify-section-{{ section.id }} .go-collection__subnav a{white-space:nowrap;padding:9px 13px;border:1px solid var(--go-line);border-radius:999px;text-decoration:none;color:inherit;}
#shopify-section-{{ section.id }} .go-collection__toolbar{display:flex;justify-content:space-between;align-items:center;padding:28px 0 18px;font-size:13px;}#shopify-section-{{ section.id }} .go-collection__toolbar form{display:flex;align-items:center;gap:10px;}#shopify-section-{{ section.id }} select{min-height:38px;border:1px solid var(--go-line);background:#fff;padding:6px 10px;border-radius:4px;}
#shopify-section-{{ section.id }} .go-collection__body{display:grid;grid-template-columns:{% if section.settings.show_filters %}240px 1fr{% else %}1fr{% endif %};gap:34px;padding-bottom:72px;}#shopify-section-{{ section.id }} .go-collection__filters{font-size:13px;}#shopify-section-{{ section.id }} .go-collection__filters details{border-top:1px solid var(--go-line);padding:14px 0;}#shopify-section-{{ section.id }} .go-collection__filters summary{font-weight:700;cursor:pointer;}#shopify-section-{{ section.id }} .go-filter-values{display:grid;gap:9px;padding:13px 0;}#shopify-section-{{ section.id }} .go-filter-values label{display:flex;gap:8px;align-items:center;}
#shopify-section-{{ section.id }} .go-product-grid{display:grid;grid-template-columns:repeat({{ section.settings.columns }},minmax(0,1fr));gap:26px 18px;}#shopify-section-{{ section.id }} .go-product-card__media{position:relative;display:block;aspect-ratio:4/5;background:#fff;overflow:hidden;}#shopify-section-{{ section.id }} .go-product-card__media img{width:100%;height:100%;object-fit:cover;}#shopify-section-{{ section.id }} .go-product-card__media .go-badge{position:absolute;top:10px;right:10px;}#shopify-section-{{ section.id }} .go-product-card__info{padding-top:12px;}#shopify-section-{{ section.id }} .go-product-card__title{display:block;color:inherit;text-decoration:none;font-size:16px;font-weight:700;margin:5px 0;}#shopify-section-{{ section.id }} .go-product-card__desc{font-size:12px;opacity:.68;min-height:18px;}#shopify-section-{{ section.id }} .go-product-card__row{margin:10px 0;}#shopify-section-{{ section.id }} .go-product-card__action{display:flex;justify-content:center;align-items:center;width:100%;min-height:42px;background:var(--go-accent);color:#fff;border:0;border-radius:4px;text-decoration:none;font-size:11px;font-weight:700;letter-spacing:.06em;}#shopify-section-{{ section.id }} .go-product-card__action.is-disabled{background:#aaa;}#shopify-section-{{ section.id }} .go-product-card s{opacity:.5;font-weight:400;margin-left:4px;}#shopify-section-{{ section.id }} .go-pagination{margin-top:36px;}#shopify-section-{{ section.id }} .go-collection__bottom{padding-bottom:76px;}
@media(max-width:989px){#shopify-section-{{ section.id }} .go-product-grid{grid-template-columns:repeat(2,minmax(0,1fr));}#shopify-section-{{ section.id }} .go-collection__body{grid-template-columns:1fr;}#shopify-section-{{ section.id }} .go-collection__filters{border:1px solid var(--go-line);padding:14px;}}
@media(max-width:749px){#shopify-section-{{ section.id }} .go-collection__hero-grid{grid-template-columns:1fr;}#shopify-section-{{ section.id }} .go-collection__hero{padding:34px 0;}#shopify-section-{{ section.id }} .go-collection__hero-media{aspect-ratio:4/3;}#shopify-section-{{ section.id }} .go-product-grid{gap:20px 10px;}#shopify-section-{{ section.id }} .go-product-card__title{font-size:14px;}}
</style>
{% schema %}
{
  "name":"GO Collection page",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Fallback eyebrow","default":"GO GROCER"},
    {"type":"checkbox","id":"show_filters","label":"Show filters","default":true},
    {"type":"checkbox","id":"show_vendor","label":"Show vendor","default":true},
    {"type":"select","id":"columns","label":"Desktop columns","default":"4","options":[{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"5","label":"5"}]},
    {"type":"select","id":"products_per_page","label":"Products per page","default":"24","options":[{"value":"12","label":"12"},{"value":"24","label":"24"},{"value":"36","label":"36"}]},
    {"type":"richtext","id":"bottom_copy","label":"Bottom SEO copy"},
    {"type":"color","id":"hero_bg","label":"Hero background","default":"#EAE2D4"},
    {"type":"color","id":"accent","label":"Accent","default":"#526653"}
  ],
  "blocks":[{"type":"subcategory","name":"Subcategory","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"label","label":"Label override"}]}],
  "max_blocks":8,
  "presets":[{"name":"GO Collection page"}]
}
{% endschema %}
