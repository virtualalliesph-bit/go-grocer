{% liquid
  assign icon_name = icon | default: 'meal'
  assign icon_size = size | default: 28
%}
<span class="go-icon go-icon--{{ icon_name }}" aria-hidden="true" style="--go-icon-size: {{ icon_size }}px;">
  {% case icon_name %}
    {% when 'meal' %}
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="16" cy="17" r="9" stroke="currentColor" stroke-width="1.7"/><circle cx="16" cy="17" r="4.5" stroke="currentColor" stroke-width="1.7"/><path d="M5 5v8M8 5v8M5 9h3M7 13v14M25 5v22M22 5v7c0 2 1.3 3 3 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% when 'protein' %}
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 5c4.8 0 8.5 4.6 8.5 10.6C24.5 22 20.7 27 16 27S7.5 22 7.5 15.6C7.5 9.6 11.2 5 16 5Z" stroke="currentColor" stroke-width="1.7"/><path d="M12 17c1.2-1.4 2.6-2.2 4-2.2s2.8.8 4 2.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="13" cy="12" r="1" fill="currentColor"/><circle cx="19" cy="12" r="1" fill="currentColor"/></svg>
    {% when 'fridge' %}
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="8" y="4" width="16" height="24" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M8 13h16M12 8v2.5M12 17v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    {% when 'swap' %}
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 11h16l-4-4M25 21H9l4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% when 'heart' %}
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 26S6 20.5 6 12.5C6 9 8.5 7 11.3 7c2 0 3.7 1 4.7 2.6C17 8 18.7 7 20.7 7 23.5 7 26 9 26 12.5 26 20.5 16 26 16 26Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
    {% when 'backup' %}
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 11 16 6l9 5-9 5-9-5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M7 11v10l9 5 9-5V11M16 16v10" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M21 7.8v5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    {% when 'breakfast' %}
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 17h14c0 5-2.7 9-7 9s-7-4-7-9Z" stroke="currentColor" stroke-width="1.7"/><path d="M7 17h18M16 5v4M8.5 8.5l2.8 2.8M23.5 8.5l-2.8 2.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    {% when 'lunch' %}
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 17h20c-.8 6-4.5 9-10 9S6.8 23 6 17Z" stroke="currentColor" stroke-width="1.7"/><path d="M9 13c1.4-2 3.6-3 7-3s5.6 1 7 3M7 17h18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    {% when 'snack' %}
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="9" y="7" width="14" height="19" rx="3" stroke="currentColor" stroke-width="1.7"/><path d="M12 12h8M12 17h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    {% when 'dinner' %}
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="16" cy="16" r="9" stroke="currentColor" stroke-width="1.7"/><path d="M12 13c2-1.5 6-1.5 8 0M11 20h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    {% when 'info' %}
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.7"/><path d="M16 14v7M16 10.5h.01" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
  {% endcase %}
</span>
<style>.go-icon{display:inline-flex;width:var(--go-icon-size);height:var(--go-icon-size);line-height:0}.go-icon svg{width:100%;height:100%;display:block}</style>