<section class="go-contact-page go-section"><div class="go-shell"><div class="go-kicker">GET IN TOUCH</div><h1 class="go-display">HOW CAN WE HELP?</h1><div class="go-copy go-rte">{{ section.settings.intro }}</div><div class="go-contact-page__grid"><div class="go-contact-page__options">{% for block in section.blocks %}{% if block.type == 'option' %}<div class="go-contact-page__option" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p>{% if block.settings.link_label != blank and block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label }} →</a>{% endif %}</div>{% endif %}{% endfor %}</div><div class="go-contact-page__form">{% form 'contact' %}{% if form.posted_successfully? %}<p class="go-contact-page__success">Thanks for reaching out. We’ll get back to you as soon as we can.</p>{% endif %}{{ form.errors | default_errors }}<label>Name<input type="text" name="contact[name]" required></label><label>Email<input type="email" name="contact[email]" required></label><label>Mobile (optional)<input type="tel" name="contact[phone]"></label><label>Topic<select name="contact[topic]"><option>Order help</option><option>Product question</option><option>Delivery</option><option>Returns</option><option>General inquiry</option></select></label><label>Order number (optional)<input type="text" name="contact[order_number]"></label><label>Message<textarea name="contact[body]" rows="7" required></textarea></label><button class="go-btn" type="submit">SEND MESSAGE</button>{% endform %}</div></div><div class="go-contact-page__faq"><h2 class="go-h2">QUICK ANSWERS</h2><div class="go-accordion">{% for block in section.blocks %}{% if block.type == 'faq' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }} <span>+</span></summary><div class="go-rte">{{ block.settings.answer }}</div></details>{% endif %}{% endfor %}</div></div></div></section><style>#shopify-section-{{ section.id }} .go-contact-page>.go-shell>.go-copy{max-width:58ch;margin-top:20px;}#shopify-section-{{ section.id }} .go-contact-page__grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:50px;margin-top:46px;}#shopify-section-{{ section.id }} .go-contact-page__options{display:grid;gap:12px;}#shopify-section-{{ section.id }} .go-contact-page__option{padding:22px;border:1px solid var(--go-line);background:#fff;}#shopify-section-{{ section.id }} .go-contact-page__option h3{margin:0 0 8px;}#shopify-section-{{ section.id }} .go-contact-page__option p{font-size:14px;}#shopify-section-{{ section.id }} .go-contact-page__option a{font-weight:700;color:inherit;}#shopify-section-{{ section.id }} .go-contact-page__form{background:var(--go-cream);padding:28px;}#shopify-section-{{ section.id }} .go-contact-page__form label{display:block;font-size:12px;font-weight:700;margin-bottom:15px;}#shopify-section-{{ section.id }} .go-contact-page__form input,#shopify-section-{{ section.id }} .go-contact-page__form select,#shopify-section-{{ section.id }} .go-contact-page__form textarea{width:100%;margin-top:7px;padding:12px;border:1px solid var(--go-line);background:#fff;border-radius:4px;}#shopify-section-{{ section.id }} .go-contact-page__success{padding:12px;background:var(--go-sage);}#shopify-section-{{ section.id }} .go-contact-page__faq{margin-top:80px;}#shopify-section-{{ section.id }} .go-contact-page__faq .go-accordion{margin-top:25px;}@media(max-width:749px){#shopify-section-{{ section.id }} .go-contact-page__grid{grid-template-columns:1fr;}}</style>{% schema %}{"name":"GO Contact page","settings":[{"type":"richtext","id":"intro","label":"Intro","default":"<p>Questions about an order, a product or GO GROCER? Send us a message and we’ll point you in the right direction.</p>"}],"blocks":[{"type":"option","name":"Contact option","settings":[{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"text","label":"Text"},{"type":"text","id":"link_label","label":"Link label"},{"type":"url","id":"link","label":"Link"}]},{"type":"faq","name":"Quick FAQ","settings":[{"type":"text","id":"question","label":"Question"},{"type":"richtext","id":"answer","label":"Answer"}]}],"presets":[{"name":"GO Contact page","blocks":[{"type":"option","settings":{"title":"ORDER HELP","text":"Include your order number so we can help faster."}},{"type":"option","settings":{"title":"PRODUCT QUESTIONS","text":"Ask about ingredients, storage, preparation or product details."}},{"type":"option","settings":{"title":"DELIVERY & RETURNS","text":"For delivery, returns and support questions, send us the details below."}},{"type":"faq","settings":{"question":"Where can I find delivery information?","answer":"<p>Delivery options and any available timeframes are shown during checkout or in the relevant store information.</p>"}},{"type":"faq","settings":{"question":"Can I ask about product nutrition?","answer":"<p>Yes. Send us the product name and your question and we’ll help with the available product information.</p>"}}]}]}{% endschema %}