{% liquid
  assign calories = product.metafields.custom.calories.value
  assign protein = product.metafields.custom.protein.value
  assign carbs = product.metafields.custom.total_carbohydrates.value
  assign fat = product.metafields.custom.total_fat.value
  assign sodium = product.metafields.custom.sodium.value
  assign serving_size = product.metafields.custom.serving_size.value
  assign ingredients = product.metafields.custom.ingredients.value
  assign allergens = product.metafields.custom.allergens.value
  assign storage = product.metafields.custom.storage_preparation.value

  assign has_nutrition = false
  if calories != blank or protein != blank or carbs != blank or fat != blank or sodium != blank or serving_size != blank
    assign has_nutrition = true
  endif
%}

<section class="go-pd" style="--go-pd-bg: {{ section.settings.background }}; --go-pd-card: {{ section.settings.card_background }}; --go-pd-accent: {{ section.settings.accent }};">
  <div class="go-pd__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.body != blank %}
      <div class="go-pd__intro">
        {% if section.settings.eyebrow != blank %}<div class="go-pd__eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.body != blank %}<div class="go-pd__body rte">{{ section.settings.body }}</div>{% endif %}
      </div>
    {% endif %}

    {% assign benefit_blocks = section.blocks | where: 'type', 'benefit' %}
    {% if benefit_blocks.size > 0 %}
      <div class="go-pd__benefits">
        {% for block in benefit_blocks %}
          <article class="go-pd__benefit" {{ block.shopify_attributes }}>
            {% if block.settings.kicker != blank %}<div class="go-pd__mini">{{ block.settings.kicker }}</div>{% endif %}
            {% if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif %}
            {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.show_collection_links and product.collections.size > 0 %}
      <div class="go-pd__browse">
        <div class="go-pd__mini">SHOP MORE LIKE THIS</div>
        <div class="go-pd__chips">
          {% for collection in product.collections limit: 6 %}
            <a href="{{ collection.url }}">{{ collection.title }}</a>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if has_nutrition or ingredients != blank or allergens != blank or storage != blank %}
      <div class="go-pd__facts">
        <div class="go-pd__facts-head">
          <div>
            <div class="go-pd__eyebrow">FOOD FACTS</div>
            <h2>{{ section.settings.facts_heading }}</h2>
          </div>
          {% if section.settings.facts_note != blank %}<p>{{ section.settings.facts_note }}</p>{% endif %}
        </div>

        {% if has_nutrition %}
          <div class="go-pd__nutrition">
            {% if calories != blank %}<div><span>CALORIES</span><strong>{{ calories }}</strong></div>{% endif %}
            {% if protein != blank %}<div><span>PROTEIN</span><strong>{{ protein }}</strong></div>{% endif %}
            {% if carbs != blank %}<div><span>TOTAL CARBS</span><strong>{{ carbs }}</strong></div>{% endif %}
            {% if fat != blank %}<div><span>TOTAL FAT</span><strong>{{ fat }}</strong></div>{% endif %}
            {% if sodium != blank %}<div><span>SODIUM</span><strong>{{ sodium }}</strong></div>{% endif %}
            {% if serving_size != blank %}<div><span>SERVING SIZE</span><strong>{{ serving_size }}</strong></div>{% endif %}
          </div>
        {% endif %}

        <div class="go-pd__accordions">
          {% if ingredients != blank %}
            <details><summary>Ingredients <span>+</span></summary><div class="rte">{{ ingredients | metafield_tag }}</div></details>
          {% endif %}
          {% if allergens != blank %}
            <details><summary>Allergens <span>+</span></summary><div class="rte">{{ allergens | metafield_tag }}</div></details>
          {% endif %}
          {% if storage != blank %}
            <details><summary>Storage &amp; Preparation <span>+</span></summary><div class="rte">{{ storage | metafield_tag }}</div></details>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% assign faq_blocks = section.blocks | where: 'type', 'faq' %}
    {% if faq_blocks.size > 0 %}
      <div class="go-pd__faq">
        <div class="go-pd__faq-title">
          <div class="go-pd__eyebrow">GOOD TO KNOW</div>
          <h2>{{ section.settings.faq_heading }}</h2>
        </div>
        <div class="go-pd__accordions">
          {% for block in faq_blocks %}
            {% if block.settings.question != blank %}
              <details {{ block.shopify_attributes }}>
                <summary>{{ block.settings.question }} <span>+</span></summary>
                {% if block.settings.answer != blank %}<div class="rte">{{ block.settings.answer }}</div>{% endif %}
              </details>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .go-pd { background: var(--go-pd-bg); color: #171717; }
  #shopify-section-{{ section.id }} .go-pd__inner { width: min(calc(100% - 72px), 1400px); margin: 0 auto; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} .go-pd__intro { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(28px, 6vw, 90px); align-items: end; margin-bottom: 34px; }
  #shopify-section-{{ section.id }} .go-pd__intro h2,
  #shopify-section-{{ section.id }} .go-pd__facts h2,
  #shopify-section-{{ section.id }} .go-pd__faq h2 { margin: 7px 0 0; font-size: clamp(34px, 4vw, 56px); line-height: .95; letter-spacing: -.045em; }
  #shopify-section-{{ section.id }} .go-pd__body { max-width: 60ch; font-size: 15px; line-height: 1.6; }
  #shopify-section-{{ section.id }} .go-pd__eyebrow,
  #shopify-section-{{ section.id }} .go-pd__mini { font-size: 10px; line-height: 1.2; letter-spacing: .13em; font-weight: 700; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .go-pd__benefits { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  #shopify-section-{{ section.id }} .go-pd__benefit { background: var(--go-pd-card); min-height: 190px; padding: 24px; border-radius: 4px; display: flex; flex-direction: column; justify-content: flex-end; }
  #shopify-section-{{ section.id }} .go-pd__benefit h3 { margin: 8px 0 6px; font-size: clamp(22px, 2.2vw, 31px); line-height: 1; letter-spacing: -.035em; }
  #shopify-section-{{ section.id }} .go-pd__benefit p { margin: 0; max-width: 34ch; font-size: 13px; line-height: 1.5; opacity: .78; }
  #shopify-section-{{ section.id }} .go-pd__browse { margin-top: 28px; padding-top: 20px; border-top: 1px solid rgba(23,23,23,.15); }
  #shopify-section-{{ section.id }} .go-pd__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  #shopify-section-{{ section.id }} .go-pd__chips a { color: inherit; text-decoration: none; border: 1px solid rgba(23,23,23,.18); border-radius: 999px; padding: 9px 14px; font-size: 12px; background: rgba(255,255,255,.42); }
  #shopify-section-{{ section.id }} .go-pd__chips a:hover { background: var(--go-pd-accent); color: #fff; border-color: var(--go-pd-accent); }
  #shopify-section-{{ section.id }} .go-pd__facts,
  #shopify-section-{{ section.id }} .go-pd__faq { margin-top: 64px; padding-top: 42px; border-top: 1px solid rgba(23,23,23,.16); }
  #shopify-section-{{ section.id }} .go-pd__facts-head { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-bottom: 26px; }
  #shopify-section-{{ section.id }} .go-pd__facts-head > p { margin: 0; max-width: 46ch; font-size: 12px; line-height: 1.5; opacity: .62; }
  #shopify-section-{{ section.id }} .go-pd__nutrition { display: grid; grid-template-columns: repeat(6, 1fr); border: 1px solid rgba(23,23,23,.14); background: var(--go-pd-card); }
  #shopify-section-{{ section.id }} .go-pd__nutrition > div { min-height: 110px; padding: 18px; border-right: 1px solid rgba(23,23,23,.12); display: flex; flex-direction: column; justify-content: space-between; }
  #shopify-section-{{ section.id }} .go-pd__nutrition > div:last-child { border-right: 0; }
  #shopify-section-{{ section.id }} .go-pd__nutrition span { font-size: 9px; letter-spacing: .12em; font-weight: 700; }
  #shopify-section-{{ section.id }} .go-pd__nutrition strong { font-size: clamp(20px, 2vw, 30px); line-height: 1; }
  #shopify-section-{{ section.id }} .go-pd__accordions { margin-top: 24px; }
  #shopify-section-{{ section.id }} .go-pd__accordions details { border-top: 1px solid rgba(23,23,23,.18); }
  #shopify-section-{{ section.id }} .go-pd__accordions details:last-child { border-bottom: 1px solid rgba(23,23,23,.18); }
  #shopify-section-{{ section.id }} .go-pd__accordions summary { list-style: none; cursor: pointer; padding: 18px 2px; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: space-between; }
  #shopify-section-{{ section.id }} .go-pd__accordions summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .go-pd__accordions summary span { font-size: 20px; font-weight: 400; transition: transform .2s ease; }
  #shopify-section-{{ section.id }} .go-pd__accordions details[open] summary span { transform: rotate(45deg); }
  #shopify-section-{{ section.id }} .go-pd__accordions .rte { padding: 0 2px 20px; max-width: 70ch; font-size: 14px; line-height: 1.6; }
  #shopify-section-{{ section.id }} .go-pd__faq { display: grid; grid-template-columns: .8fr 1.2fr; gap: 60px; align-items: start; }
  #shopify-section-{{ section.id }} .go-pd__faq .go-pd__accordions { margin-top: 0; }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .go-pd__benefits { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .go-pd__benefit { min-height: 150px; }
    #shopify-section-{{ section.id }} .go-pd__nutrition { grid-template-columns: repeat(3, 1fr); }
    #shopify-section-{{ section.id }} .go-pd__nutrition > div:nth-child(3n) { border-right: 0; }
    #shopify-section-{{ section.id }} .go-pd__nutrition > div:nth-child(-n+3) { border-bottom: 1px solid rgba(23,23,23,.12); }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .go-pd__inner { width: min(calc(100% - 36px), 1400px); padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px; }
    #shopify-section-{{ section.id }} .go-pd__intro,
    #shopify-section-{{ section.id }} .go-pd__faq { grid-template-columns: 1fr; gap: 22px; }
    #shopify-section-{{ section.id }} .go-pd__facts,
    #shopify-section-{{ section.id }} .go-pd__faq { margin-top: 46px; padding-top: 32px; }
    #shopify-section-{{ section.id }} .go-pd__facts-head { display: block; }
    #shopify-section-{{ section.id }} .go-pd__facts-head > p { margin-top: 14px; }
    #shopify-section-{{ section.id }} .go-pd__nutrition { grid-template-columns: repeat(2, 1fr); }
    #shopify-section-{{ section.id }} .go-pd__nutrition > div { border-right: 1px solid rgba(23,23,23,.12); border-bottom: 1px solid rgba(23,23,23,.12); }
    #shopify-section-{{ section.id }} .go-pd__nutrition > div:nth-child(2n) { border-right: 0; }
  }
</style>

{% schema %}
{
  "name": "GO Product support",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"GO GROCER STANDARD"},
    {"type":"text","id":"heading","label":"Heading","default":"GOOD FOOD. EASIER CHOICES."},
    {"type":"richtext","id":"body","label":"Body","default":"<p>Everyday groceries selected for quality, convenience and protein-forward living. Less overthinking, more useful food for your fridge.</p>"},
    {"type":"checkbox","id":"show_collection_links","label":"Show product collection links","default":true},
    {"type":"text","id":"facts_heading","label":"Food facts heading","default":"NUTRITION AT A GLANCE."},
    {"type":"text","id":"facts_note","label":"Food facts note","default":"Nutrition information is product specific. Always check the product packaging for the most current details."},
    {"type":"text","id":"faq_heading","label":"FAQ heading","default":"A FEW USEFUL THINGS."},
    {"type":"color","id":"background","label":"Background","default":"#EAE2D4"},
    {"type":"color","id":"card_background","label":"Card background","default":"#F7F5F0"},
    {"type":"color","id":"accent","label":"Accent","default":"#526653"},
    {"type":"range","id":"padding_top","label":"Top padding desktop","min":20,"max":120,"step":4,"default":64,"unit":"px"},
    {"type":"range","id":"padding_bottom","label":"Bottom padding desktop","min":20,"max":120,"step":4,"default":72,"unit":"px"},
    {"type":"range","id":"padding_top_mobile","label":"Top padding mobile","min":16,"max":80,"step":4,"default":44,"unit":"px"},
    {"type":"range","id":"padding_bottom_mobile","label":"Bottom padding mobile","min":16,"max":80,"step":4,"default":52,"unit":"px"}
  ],
  "blocks": [
    {
      "type":"benefit",
      "name":"Benefit",
      "settings":[
        {"type":"text","id":"kicker","label":"Kicker","default":"EVERYDAY PROTEIN"},
        {"type":"text","id":"title","label":"Title","default":"Protein made easier."},
        {"type":"textarea","id":"text","label":"Text","default":"Useful staples and convenient choices that make protein-forward eating simpler."}
      ]
    },
    {
      "type":"faq",
      "name":"General FAQ",
      "settings":[
        {"type":"text","id":"question","label":"Question","default":"How does GO GROCER choose products?"},
        {"type":"richtext","id":"answer","label":"Answer","default":"<p>We focus on practical everyday food, useful nutrition and products that fit easily into real routines.</p>"}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name":"GO Product support",
      "blocks":[
        {"type":"benefit","settings":{"kicker":"PROTEIN MADE EASY","title":"Useful everyday protein.","text":"Simple staples and convenient options for breakfast, lunch, snacks and dinner."}},
        {"type":"benefit","settings":{"kicker":"GOOD FOOD, REAL LIFE","title":"Chosen for everyday living.","text":"Premium enough to feel good, practical enough to keep stocked in your fridge."}},
        {"type":"benefit","settings":{"kicker":"LESS OVERTHINKING","title":"A smarter grocery run.","text":"Clear choices, useful categories and food that works with busy routines."}},
        {"type":"faq","settings":{"question":"How does GO GROCER choose products?","answer":"<p>We focus on practical everyday food, good quality and products that make protein-forward grocery shopping easier.</p>"}},
        {"type":"faq","settings":{"question":"Where can I find nutrition information?","answer":"<p>Nutrition varies by product. Check the nutrition section on the product page when available and always refer to the product packaging for the most current information.</p>"}}
      ]
    }
  ]
}
{% endschema %}
