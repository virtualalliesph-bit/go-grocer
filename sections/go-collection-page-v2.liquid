{% liquid
  assign eyebrow = collection.metafields.custom.eyebrow.value | default: section.settings.eyebrow
  assign short_desc = collection.metafields.custom.short_description.value | default: collection.description
  assign hero_image = collection.metafields.custom.hero_image.value | default: collection.image
  assign seo_copy = collection.metafields.custom.seo_copy.value | default: section.settings.bottom_copy
  assign sort_by = collection.sort_by | default: collection.default_sort_by
%}

<section
  class="go-collection-v2"
  style="--go-accent: {{ section.settings.accent }}; --go-hero-bg: {{ section.settings.hero_bg }}; --go-image-fit: {{ section.settings.product_image_fit }};"
>
  <div class="go-collection-v2__hero go-collection-v2__hero--{{ section.settings.hero_size }}">
    <div class="go-shell go-collection-v2__hero-grid">
      <div class="go-collection-v2__hero-copy">
        {% if eyebrow != blank %}
          <div class="go-collection-v2__eyebrow">{{ eyebrow }}</div>
        {% endif %}
        <h1 class="go-collection-v2__title">{{ collection.title }}</h1>
        {% if short_desc != blank %}
          <div class="go-collection-v2__intro rte">{{ short_desc }}</div>
        {% endif %}
      </div>

      {% if hero_image != blank %}
        <div class="go-collection-v2__hero-media">
          {{
            hero_image
            | image_url: width: 1800
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '640, 900, 1200, 1600, 1800',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: collection.title
          }}
        </div>
      {% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="go-shell go-collection-v2__subnav-wrap">
      <nav class="go-collection-v2__subnav" aria-label="Collection categories">
        {% for block in section.blocks %}
          {% if block.settings.collection != blank %}
            <a
              href="{{ block.settings.collection.url }}"
              class="{% if block.settings.collection.handle == collection.handle %}is-active{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | default: block.settings.collection.title }}
            </a>
          {% endif %}
        {% endfor %}
      </nav>
    </div>
  {% endif %}

  <div class="go-shell go-collection-v2__toolbar">
    <div class="go-collection-v2__count">{{ collection.products_count }} products</div>
    <form class="go-collection-v2__sort" method="get">
      {% for filter in collection.filters %}
        {% for value in filter.active_values %}
          <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
        {% endfor %}
        {% if filter.type == 'price_range' %}
          {% if filter.min_value.value != nil %}
            <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}">
          {% endif %}
          {% if filter.max_value.value != nil %}
            <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}">
          {% endif %}
        {% endif %}
      {% endfor %}
      <label for="SortBy-{{ section.id }}">Sort</label>
      <select id="SortBy-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
        {% for option in collection.sort_options %}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
        {% endfor %}
      </select>
    </form>
  </div>

  {% paginate collection.products by section.settings.products_per_page %}
    {% if section.settings.show_filters and collection.filters.size > 0 %}
      <div class="go-shell go-collection-v2__mobile-filters">
        <details>
          <summary>FILTER & REFINE</summary>
          <form method="get" id="GoFiltersMobile-{{ section.id }}" class="go-collection-v2__filter-form">
            {% if collection.sort_by != blank %}
              <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
            {% endif %}
            {% for filter in collection.filters %}
              <div class="go-collection-v2__filter-group">
                <div class="go-collection-v2__filter-title">{{ filter.label }}</div>
                <div class="go-collection-v2__filter-values">
                  {% case filter.type %}
                    {% when 'list', 'boolean' %}
                      {% for value in filter.values %}
                        <label>
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          <span>{{ value.label }}</span>
                          <span class="go-collection-v2__filter-count">{{ value.count }}</span>
                        </label>
                      {% endfor %}
                    {% when 'price_range' %}
                      <div class="go-collection-v2__price-range">
                        <label>
                          <span>Min</span>
                          <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" min="0">
                        </label>
                        <label>
                          <span>Max</span>
                          <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" min="0">
                        </label>
                      </div>
                  {% endcase %}
                </div>
              </div>
            {% endfor %}
            <div class="go-collection-v2__filter-actions">
              <button class="go-collection-v2__apply" type="submit">APPLY FILTERS</button>
              <a href="{{ collection.url }}">CLEAR</a>
            </div>
          </form>
        </details>
      </div>
    {% endif %}

    <div class="go-shell go-collection-v2__body">
      {% if section.settings.show_filters and collection.filters.size > 0 %}
        <aside class="go-collection-v2__filters">
          <form method="get" id="GoFiltersDesktop-{{ section.id }}" class="go-collection-v2__filter-form">
            {% if collection.sort_by != blank %}
              <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
            {% endif %}

            {% for filter in collection.filters %}
              <details open class="go-collection-v2__filter-group">
                <summary>{{ filter.label }}</summary>
                <div class="go-collection-v2__filter-values">
                  {% case filter.type %}
                    {% when 'list', 'boolean' %}
                      {% for value in filter.values %}
                        <label>
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          <span>{{ value.label }}</span>
                          <span class="go-collection-v2__filter-count">{{ value.count }}</span>
                        </label>
                      {% endfor %}
                    {% when 'price_range' %}
                      <div class="go-collection-v2__price-range">
                        <label>
                          <span>Min</span>
                          <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" min="0">
                        </label>
                        <label>
                          <span>Max</span>
                          <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" min="0">
                        </label>
                      </div>
                  {% endcase %}
                </div>
              </details>
            {% endfor %}

            <div class="go-collection-v2__filter-actions">
              <button class="go-collection-v2__apply" type="submit">APPLY FILTERS</button>
              <a href="{{ collection.url }}">CLEAR</a>
            </div>
          </form>
        </aside>
      {% endif %}

      <div class="go-collection-v2__main">
        {% if collection.products.size > 0 %}
          <div class="go-collection-v2__grid">
            {% for product in collection.products %}
              <article class="go-collection-v2__card">
                <a class="go-collection-v2__media" href="{{ product.url }}">
                  {% if product.featured_image %}
                    {{
                      product.featured_image
                      | image_url: width: 1000
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 540, 720, 900, 1000',
                        sizes: '(min-width: 1200px) 22vw, (min-width: 750px) 30vw, 50vw',
                        alt: product.title
                    }}
                  {% endif %}

                  {% if product.metafields.custom.protein_per_serving != blank %}
                    <span class="go-collection-v2__badge">{{ product.metafields.custom.protein_per_serving.value }}</span>
                  {% endif %}
                </a>

                <div class="go-collection-v2__card-info">
                  <div class="go-collection-v2__card-copy">
                    {% if section.settings.show_vendor and product.vendor != blank %}
                      <div class="go-collection-v2__vendor">{{ product.vendor }}</div>
                    {% endif %}
                    <a class="go-collection-v2__product-title" href="{{ product.url }}">{{ product.title }}</a>
                    {% if product.metafields.custom.short_description != blank %}
                      <div class="go-collection-v2__product-desc">{{ product.metafields.custom.short_description.value }}</div>
                    {% endif %}
                    <div class="go-collection-v2__price">
                      {{ product.price | money }}
                      {% if product.compare_at_price > product.price %}
                        <s>{{ product.compare_at_price | money }}</s>
                      {% endif %}
                    </div>
                  </div>

                  {% if product.available %}
                    {% if product.has_only_default_variant %}
                      {% form 'product', product %}
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        <button class="go-collection-v2__action" type="submit">QUICK ADD</button>
                      {% endform %}
                    {% else %}
                      <a class="go-collection-v2__action" href="{{ product.url }}">CHOOSE OPTIONS</a>
                    {% endif %}
                  {% else %}
                    <span class="go-collection-v2__action is-disabled">SOLD OUT</span>
                  {% endif %}
                </div>
              </article>
            {% endfor %}
          </div>
        {% else %}
          <div class="go-collection-v2__empty">
            <strong>No products found.</strong>
            <span>Try adjusting your filters or check back soon.</span>
          </div>
        {% endif %}

        {% if paginate.pages > 1 %}
          <nav class="go-collection-v2__pagination" aria-label="Pagination">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      </div>
    </div>
  {% endpaginate %}

  {% if seo_copy != blank %}
    <div class="go-shell go-collection-v2__seo">
      <div class="go-collection-v2__seo-inner rte">{{ seo_copy }}</div>
    </div>
  {% endif %}
</section>

<style>
  #shopify-section-{{ section.id }} .go-collection-v2 {
    color: #171717;
    background: #F7F5F0;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__hero {
    background: var(--go-hero-bg);
  }

  #shopify-section-{{ section.id }} .go-collection-v2__hero--compact {
    padding: 32px 0;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__hero--standard {
    padding: 48px 0;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__hero--large {
    padding: 64px 0;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__hero-grid {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 76px);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__hero-copy {
    max-width: 620px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__eyebrow,
  #shopify-section-{{ section.id }} .go-collection-v2__vendor {
    font-size: 11px;
    line-height: 1.2;
    letter-spacing: .12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__title {
    margin: 8px 0 0;
    font-size: clamp(48px, 5.5vw, 78px);
    line-height: .92;
    letter-spacing: -.045em;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__intro {
    max-width: 56ch;
    margin-top: 20px;
    font-size: 15px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__intro > *:first-child,
  #shopify-section-{{ section.id }} .go-collection-v2__seo-inner > *:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__intro > *:last-child,
  #shopify-section-{{ section.id }} .go-collection-v2__seo-inner > *:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__hero-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 4px;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__subnav-wrap {
    padding-top: 18px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__subnav {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 12px;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__subnav::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__subnav a {
    flex: 0 0 auto;
    padding: 10px 14px;
    border: 1px solid rgba(23, 23, 23, .16);
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    transition: background .2s ease, color .2s ease, border-color .2s ease;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__subnav a:hover,
  #shopify-section-{{ section.id }} .go-collection-v2__subnav a.is-active {
    background: var(--go-accent);
    color: #fff;
    border-color: var(--go-accent);
  }

  #shopify-section-{{ section.id }} .go-collection-v2__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 70px;
    border-bottom: 1px solid rgba(23, 23, 23, .12);
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__count {
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__sort {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__sort label {
    font-size: 12px;
    opacity: .68;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__sort select,
  #shopify-section-{{ section.id }} .go-collection-v2__price-range input {
    min-height: 40px;
    border: 1px solid rgba(23, 23, 23, .18);
    border-radius: 4px;
    background: #fff;
    color: #171717;
    padding: 8px 11px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__body {
    display: grid;
    grid-template-columns: {% if section.settings.show_filters %}220px minmax(0, 1fr){% else %}minmax(0, 1fr){% endif %};
    gap: clamp(26px, 3vw, 46px);
    padding-top: 30px;
    padding-bottom: 76px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__filters {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__filter-form {
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__filters .go-collection-v2__filter-form {
    position: sticky;
    top: 110px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__filter-group {
    margin: 0;
    padding: 16px 0;
    border-top: 1px solid rgba(23, 23, 23, .12);
  }

  #shopify-section-{{ section.id }} .go-collection-v2__filter-group:last-of-type {
    border-bottom: 1px solid rgba(23, 23, 23, .12);
  }

  #shopify-section-{{ section.id }} .go-collection-v2__filter-group summary,
  #shopify-section-{{ section.id }} .go-collection-v2__filter-title {
    cursor: pointer;
    list-style: none;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__filter-values {
    display: grid;
    gap: 10px;
    padding-top: 14px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__filter-values label {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__filter-values input[type='checkbox'] {
    width: 15px;
    height: 15px;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__filter-count {
    opacity: .5;
    font-size: 11px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__price-range {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__price-range label {
    display: grid;
    grid-template-columns: 1fr;
    gap: 5px;
    font-size: 11px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__filter-actions {
    display: grid;
    gap: 10px;
    padding-top: 16px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__filter-actions a {
    color: inherit;
    text-align: center;
    font-size: 11px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__apply {
    min-height: 42px;
    border: 0;
    border-radius: 4px;
    background: var(--go-accent);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .06em;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    gap: 34px 18px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__card {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 3px;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__media img {
    width: 100%;
    height: 100%;
    object-fit: var(--go-image-fit);
    transition: transform .35s ease;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__media:hover img {
    transform: scale(1.025);
  }

  #shopify-section-{{ section.id }} .go-collection-v2__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    padding: 7px 9px;
    border-radius: 999px;
    background: var(--go-accent);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .04em;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__card-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    padding-top: 13px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__product-title {
    display: block;
    margin-top: 5px;
    color: inherit;
    text-decoration: none;
    font-size: 15px;
    line-height: 1.25;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__product-desc {
    margin-top: 6px;
    font-size: 12px;
    line-height: 1.45;
    opacity: .66;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__price {
    margin-top: 10px;
    font-size: 13px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__price s {
    margin-left: 5px;
    opacity: .45;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__card form {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__action {
    display: flex;
    width: 100%;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--go-accent);
    border-radius: 4px;
    background: var(--go-accent);
    color: #fff;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .06em;
    transition: background .2s ease, color .2s ease;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__action:hover {
    background: transparent;
    color: var(--go-accent);
  }

  #shopify-section-{{ section.id }} .go-collection-v2__action.is-disabled {
    border-color: #aaa;
    background: #aaa;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__empty {
    display: grid;
    gap: 6px;
    min-height: 260px;
    place-content: center;
    text-align: center;
    border: 1px dashed rgba(23, 23, 23, .18);
  }

  #shopify-section-{{ section.id }} .go-collection-v2__empty span {
    font-size: 13px;
    opacity: .62;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__pagination {
    margin-top: 44px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__seo {
    padding-bottom: 80px;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__seo-inner {
    max-width: 760px;
    padding-top: 34px;
    border-top: 1px solid rgba(23, 23, 23, .12);
    font-size: 14px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .go-collection-v2__mobile-filters {
    display: none;
  }

  @media (max-width: 1199px) {
    #shopify-section-{{ section.id }} .go-collection-v2__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .go-collection-v2__hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 28px;
    }

    #shopify-section-{{ section.id }} .go-collection-v2__body {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .go-collection-v2__filters {
      display: none;
    }

    #shopify-section-{{ section.id }} .go-collection-v2__mobile-filters {
      display: block;
      padding-top: 16px;
    }

    #shopify-section-{{ section.id }} .go-collection-v2__mobile-filters details {
      border: 1px solid rgba(23, 23, 23, .14);
      background: #fff;
    }

    #shopify-section-{{ section.id }} .go-collection-v2__mobile-filters summary {
      padding: 14px 16px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .06em;
    }

    #shopify-section-{{ section.id }} .go-collection-v2__mobile-filters .go-collection-v2__filter-form {
      padding: 0 16px 16px;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .go-collection-v2__hero--compact,
